# String de conexão do banco de dados (Exemplo usando Supabase ou PostgreSQL local)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# URL da aplicação em ambiente local ou produção
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Secret utilizado pelo NextAuth para assinar os tokens JWT (gere um hash seguro)
NEXTAUTH_SECRET="sua_chave_secreta_aqui"
